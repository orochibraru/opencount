{
	"$schema": "https://raw.githubusercontent.com/orochibraru/homerun/main/manifest.schema.json",
	"name": "OpenCount",
	"category": "finance",
	"gitBuildMethod": "dockerfile",
	"gitBuildContext": ".",
	"gitDockerfilePath": "Dockerfile",
	"containerPort": 3000,
	"domains": ["opencount.eu"],
	"primaryDomain": "opencount.eu",
	"envVars": {
		"ADDRESS_HEADER": "x-forwarded-for",
		"XFF_DEPTH": "1",
		"LOG_FORMAT": "json"
	},
	"autoRollback": true,
	"imageScanEnabled": true,
	"uptimeEnabled": true,
	"tracesEnabled": true,
	"blockedPaths": [
		"wp-admin",
		"wp-login.php",
		"wp-config.php*",
		"wp-content",
		"wp-includes",
		"wp-json",
		"xmlrpc.php",
		".env",
		".env.*",
		".git",
		".git-credentials",
		".gitconfig",
		".svn",
		".hg",
		".aws",
		".ssh",
		".htpasswd",
		".htaccess",
		".npmrc",
		".DS_Store",
		"*.sql",
		"*.sql.gz",
		"*.sqlite",
		"*.bak",
		"*.swp",
		"id_rsa*",
		"phpmyadmin",
		"phpinfo.php",
		"adminer.php",
		"server-status",
		"cgi-bin"
	],
	"previewsEnabled": true,
	"previewBranchExclude": [
		"dependabot/*",
		"renovate/*",
		"docs/*",
		"releaser/*"
	],
	"previewCopyVolumes": false,
	"previewAuthRequired": true,
	"previewAuthProviders": ["email-otp"]
}
